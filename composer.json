{
    "name": "lingoda/ai-sdk",
    "type": "library",
    "description": "Framework-agnostic PHP SDK for AI providers with typed results and platform abstraction",
    "keywords": [
        "ai",
        "openai",
        "anthropic",
        "gemini",
        "machine-learning",
        "chatgpt",
        "claude",
        "bedrock"
    ],
    "license": "MIT",
    "authors": [
        {
            "name": "Balazs Csaba",
            "email": "csaba.balazs@lingoda.com"
        }
    ],
    "require": {
        "php": "^8.4",
        "ext-fileinfo": "*",
        "google-gemini-php/client": "^2.5",
        "mozex/anthropic-php": "^1.1",
        "nyholm/psr7": "^1.8",
        "openai-php/client": "^v0.16",
        "psr/http-client": "^1.0",
        "psr/http-factory": "^1.1",
        "psr/http-message": "^1.0|^2.0",
        "psr/log": "^1.0|^2.0|^3.0",
        "symfony/http-client": "^7.4|^8.0",
        "symfony/http-client-contracts": "^3.6",
        "symfony/lock": "^7.4|^8.0",
        "symfony/rate-limiter": "^7.4|^8.0",
        "webmozart/assert": "^1.11"
    },
    "require-dev": {
        "async-aws/bedrock-runtime": "^1.3",
        "dg/bypass-finals": "^1.7",
        "phpstan/phpstan": "^2.1",
        "phpstan/phpstan-phpunit": "^2.0",
        "phpstan/phpstan-webmozart-assert": "^2.0",
        "phpunit/phpunit": "^10.5",
        "symfony/ai-bedrock-platform": "~0.13.0",
        "symfony/var-dumper": "^7.4|^8.0",
        "symplify/easy-coding-standard": "^12.0"
    },
    "suggest": {
        "async-aws/bedrock-runtime": "Required for the AWS Bedrock provider",
        "symfony/ai-bedrock-platform": "Required for the AWS Bedrock provider (~0.13.0)"
    },
    "conflict": {
        "symfony/ai-bedrock-platform": "<0.13 || >=0.14"
    },
    "autoload": {
        "psr-4": {
            "Lingoda\\AiSdk\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Lingoda\\AiSdk\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "php-http/discovery": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
